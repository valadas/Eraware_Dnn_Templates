{
  "name": "$ext_scopeprefixkebab$",
  "version": "0.1.0",
  "private": true,
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/$ext_scopeprefixkebab$/$ext_scopeprefixkebab$.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "lint": "eslint",
    "build": "stencil build --docs && npm run lint",
    "start": "stencil build --dev --watch --serve --no-open",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "tsdoc": "tsc src/services/services.ts --declaration --emitDeclarationOnly --target es2017 --moduleResolution nodenext --module nodenext && api-extractor run --local && api-documenter markdown -i temp -o tempmd"
  },
  "//overrides": "TEMPORARY: eslint-plugin-react doesn't support eslint v10 yet. Remove this override when https://github.com/jsx-eslint/eslint-plugin-react/issues/3977 is resolved.",
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "devDependencies": {
    "@dnncommunity/dnn-elements": "^0.27.4",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-documenter": "^7.13.49",
    "@microsoft/api-extractor": "^7.18.9",
    "@stencil/eslint-plugin": "^1.3.1",
    "@stencil/core": "^4.38.0",
    "@stencil/sass": "^3.0.2",
    "@stencil/store": "^2.0.0",
    "@types/node": "^25.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "jiti": "^2.4.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  },
  "license": "MIT"
}
