{
  "name": "$ext_scopeprefixkebab$",
  "version": "0.1.0",
  "private": true,
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/$ext_scopeprefixkebab$/$ext_scopeprefixkebab$.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "lint": "eslint",
    "build": "stencil build --docs && npm run lint",
    "postbuild": "tsc --project ./src/dnn/tsconfig.json",
    "start": "stencil build --dev --watch --serve --no-open",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate"
  },
  "//overrides": "TEMPORARY: eslint-plugin-react doesn't support eslint v10 yet. Remove this override when https://github.com/jsx-eslint/eslint-plugin-react/issues/3977 is resolved.",
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "devDependencies": {
    "@dnncommunity/dnn-elements": "^0.27.4",
    "@eslint/js": "^9.36.0",
    "@stencil/core": "^4.38.0",
    "@stencil/eslint-plugin": "^1.3.",
    "@stencil/sass": "^3.0.2",
    "@types/jquery": "^3.5.30",
    "@types/node": "^25.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "dayjs": "^1.11.13",
    "jiti": "^2.4.2",
    "jquery": "^3.7.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  },
  "license": "MIT"
}
